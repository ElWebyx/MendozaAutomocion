rules_version = '2';

// ==========================================================================
// Mendoza Automoción · Reglas de seguridad de Firestore
// Copia todo esto en Firebase > Firestore Database > Reglas y pulsa Publicar.
// Cambia el correo de abajo por el del administrador (puedes poner varios).
// ==========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'mendozaautomocion@gmail.com'
        ];
    }

    // Lo que se ve en la web: todo el mundo lo puede leer, solo el admin lo cambia
    match /vehiculos/{id} { allow read: if true; allow write: if esAdmin(); }
    match /ajustes/{id}   { allow read: if true; allow write: if esAdmin(); }
    match /fotos/{id}     { allow read: if true; allow write: if esAdmin(); }

    // Comprobación de acceso del panel
    match /privado/{id}   { allow read, write: if esAdmin(); }
  }
}
