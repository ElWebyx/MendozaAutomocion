{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "ADMIN-LEEME.md",
      "firebase/**"
    ],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(jpg|jpeg|png|webp|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  }
}
